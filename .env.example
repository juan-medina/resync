# ==============================================================================
# PRODUCTION SYNC SETTINGS
# Used when running `make sync`
# ==============================================================================

# Target Spotify Playlist (source to copy from)
SPOTIFY_PLAYLIST_ID="https://open.spotify.com/playlist/YOUR_PLAYLIST_ID"

# Target YouTube Music Playlist (destination to sync into)
YOUTUBE_PLAYLIST_ID="YOUR_YOUTUBE_PLAYLIST_ID"

# Set to true to test matching without modifying the YouTube playlist
#DRY_RUN=true

# Optional: Limit how many tracks to evaluate during a sync
#SPOTIFY_MAX_TRACKS=1000

# ==============================================================================
# ML TRAINING PIPELINE SETTINGS
# Used ONLY if you are retraining the AI model from scratch
# ==============================================================================

# Gemini API Key (Required for `ai_labeler.py` to auto-label the dataset)
GEMINI_API_KEY="your_gemini_api_key_here"

# Model used for AI auto-labeling (e.g. gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Playlist used to generate the training dataset
TRAINING_SPOTIFY_PLAYLIST_ID="https://open.spotify.com/playlist/TRAINING_PLAYLIST_ID"

# ==============================================================================
# GLOBAL SETTINGS & RATE LIMITS
# Used by both Production and Training
# ==============================================================================

# The randomized delay (in seconds) between each search request to prevent 403s.
# Format: min,max
SEARCH_PACING_RANGE=2.5,5.0

# The delays (in seconds) to wait before retrying after a 403 rate limit block.
# Format: comma-separated list of integers
RETRY_DELAYS=45,90,180

# Logging level for the application (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# MusicBrainz Settings
MB_USER_AGENT="SpotifyYTMusicSync/1.0 (your@email.com)"
